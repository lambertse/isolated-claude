#!/usr/bin/env bash
# ai-agent-vm — launch AI Agent CLI inside a per-project Docker container.
#
# Design:
#   - One container per project directory (name derived from path hash).
#   - A shared Docker named volume `ai-agent-vm-auth` holds ~/.claude so you log in once.
#   - Only the current dir is bind-mounted. No other host paths leak in.
#   - `ai-agent-vm`              -> start/reuse container, exec a fresh agent session
#   - `ai-agent-vm login`        -> one-time OAuth login (forwards callback port)
#   - `ai-agent-vm shell`        -> drop into a bash shell inside the container
#   - `ai-agent-vm stop`         -> stop this project's container
#   - `ai-agent-vm rm`           -> stop + remove this project's container
#   - `ai-agent-vm ps`           -> list all ai-agent-vm containers
#   - `ai-agent-vm upgrade [v]`  -> update the CLI inside the container in place
#   - `ai-agent-vm commit`       -> snapshot the container back into the image
#   - `ai-agent-vm rebuild`      -> rebuild the image
#
# Each invocation spawns a NEW agent process, so using this as a tmux keybind
# gives you independent agent sessions per pane while sharing the project container.

set -euo pipefail

# Name of the CLI binary installed in the image (see Dockerfile). Kept in one
# place since it's the one unavoidable reference to the upstream package name.
AGENT_BIN="${AI_AGENT_VM_BIN:-claude}"

# npm package that provides the CLI. Used by `upgrade` to reinstall inside a
# running container. NOTE: the Dockerfile hardcodes this same name at build
# time, so this var is not a single source of truth — keep the two in sync.
AGENT_PKG="${AI_AGENT_VM_PKG:-@anthropic-ai/claude-code}"

IMAGE_NAME="${AI_AGENT_VM_IMAGE:-ai-agent-vm:latest}"
AUTH_VOLUME="${AI_AGENT_VM_AUTH_VOLUME:-ai-agent-vm-auth}"
# Second volume for ~/.claude.json (the config file, NOT the directory) —
# a path hardcoded by the AI Agent CLI itself, not something we choose.
# AI Agent CLI stores account/onboarding state there; without it, you're prompted to log in
# again even with a valid token in .credentials.json.
CONFIG_VOLUME="${AI_AGENT_VM_CONFIG_VOLUME:-ai-agent-vm-config}"
# OAuth callback port used by AI Agent CLI. Override if Anthropic changes it.
OAUTH_PORT="${AI_AGENT_VM_OAUTH_PORT:-54545}"

# Resolve the directory where this script + Dockerfile live (for `rebuild`).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { echo "ai-agent-vm: $*" >&2; exit 1; }

need_docker() {
  command -v docker >/dev/null 2>&1 || die "docker not found in PATH"
  docker info >/dev/null 2>&1 || die "docker daemon not reachable (is Docker Desktop / Colima running?)"
}

# Stable short name for the current working directory.
project_container_name() {
  local pwd_abs
  pwd_abs="$(pwd -P)"
  # 12-char hash keeps names short and collision-free in practice.
  local hash
  hash="$(printf '%s' "$pwd_abs" | shasum -a 256 | cut -c1-12)"
  echo "ai-agent-vm-${hash}"
}

image_exists() {
  docker image inspect "$IMAGE_NAME" >/dev/null 2>&1
}

ensure_image() {
  if ! image_exists; then
    echo "ai-agent-vm: image '$IMAGE_NAME' not found, building from $SCRIPT_DIR ..." >&2
    docker build -t "$IMAGE_NAME" "$SCRIPT_DIR"
  fi
}

ensure_auth_volume() {
  local just_created=0
  if ! docker volume inspect "$AUTH_VOLUME" >/dev/null 2>&1; then
    docker volume create "$AUTH_VOLUME" >/dev/null
    just_created=1
  fi

  # Seed from host ~/.claude on first creation only — lets you skip OAuth if
  # already logged in on host. Never re-seed an existing volume (would clobber
  # container-only state like session isolation symlinks).
  if [[ "$just_created" -eq 1 ]] && [[ -d "$HOME/.claude" ]]; then
    echo "ai-agent-vm: seeding auth volume from ~/.claude ..." >&2
    docker run --rm \
      --user 0:0 \
      -v "$AUTH_VOLUME:/dst" \
      -v "$HOME/.claude:/src:ro" \
      --entrypoint sh \
      "$IMAGE_NAME" -c 'cp -a /src/. /dst/' >/dev/null
  fi

  # Always (re)assert ownership, not just on first creation. A fresh named
  # volume defaults to root:root, and a volume from a prior buggy run (or
  # created/touched by any other root-run container) can drift back to
  # root-owned — entrypoint.sh runs as uid 1000 (`node`) and needs write
  # access every time. This is idempotent and cheap, so just always run it.
  docker run --rm \
    --user 0:0 \
    -v "$AUTH_VOLUME:/dst" \
    --entrypoint sh \
    "$IMAGE_NAME" -c 'chown -R 1000:1000 /dst' >/dev/null
}

ensure_config_volume() {
  # Creates/initialises the volume that holds ~/.claude.json (the file).
  # Strategy: the volume is mounted at /home/node/.ai-agent-config in every container,
  # and we symlink ~/.claude.json -> /home/node/.ai-agent-config/agent.json on container start.
  # If a backup exists in the auth volume (AI Agent CLI writes one), restore from it.
  if ! docker volume inspect "$CONFIG_VOLUME" >/dev/null 2>&1; then
    docker volume create "$CONFIG_VOLUME" >/dev/null
    echo "ai-agent-vm: initialising config volume ..." >&2
    docker run --rm \
      --user 0:0 \
      -v "$CONFIG_VOLUME:/cfg" \
      -v "$AUTH_VOLUME:/auth:ro" \
      --entrypoint sh \
      "$IMAGE_NAME" -c '
        chown 1000:1000 /cfg
        # If a backup of .claude.json exists in the auth volume, restore newest one.
        if [ -d /auth/backups ]; then
          latest=$(ls -1t /auth/backups/.claude.json.backup.* 2>/dev/null | head -n1)
          if [ -n "$latest" ]; then
            cp "$latest" /cfg/agent.json
            chown 1000:1000 /cfg/agent.json
            echo "ai-agent-vm: restored .claude.json from $latest" >&2
          fi
        fi
        # Also seed from host ~/.claude.json if present.
        if [ -f /host-home/.claude.json ]; then
          cp /host-home/.claude.json /cfg/agent.json
          chown 1000:1000 /cfg/agent.json
          echo "ai-agent-vm: seeded .claude.json from host" >&2
        fi
      ' >/dev/null || true
    # Second pass: seed from host file if present (mounted separately to avoid failure if missing).
    if [[ -f "$HOME/.claude.json" ]]; then
      docker run --rm \
        --user 0:0 \
        -v "$CONFIG_VOLUME:/cfg" \
        -v "$HOME/.claude.json:/src.json:ro" \
        --entrypoint sh \
        "$IMAGE_NAME" -c 'cp /src.json /cfg/agent.json && chown 1000:1000 /cfg/agent.json' >/dev/null
    fi
  fi
}

# Shell snippet that every container runs at start/exec to link ~/.claude.json
# into the config volume. Safe to run repeatedly.
link_config_cmd() {
  cat <<'SH'
if [ ! -L "$HOME/.claude.json" ]; then
  # If a real file exists (first boot, no symlink yet), move it into the volume.
  if [ -f "$HOME/.claude.json" ] && [ ! -f "$HOME/.ai-agent-config/agent.json" ]; then
    cp "$HOME/.claude.json" "$HOME/.ai-agent-config/agent.json"
  fi
  rm -f "$HOME/.claude.json"
  ln -s "$HOME/.ai-agent-config/agent.json" "$HOME/.claude.json"
fi
# Ensure the target file exists (empty JSON is fine as a placeholder).
[ -f "$HOME/.ai-agent-config/agent.json" ] || echo '{}' > "$HOME/.ai-agent-config/agent.json"
SH
}

container_state() {
  # Prints: "running", "exited", or "" if missing.
  docker inspect -f '{{.State.Status}}' "$1" 2>/dev/null || true
}

ensure_container() {
  local name="$1"
  local state
  state="$(container_state "$name")"

  case "$state" in
    running) : ;;  # already up
    exited|created)
      docker start "$name" >/dev/null
      ;;
    "")
      docker run -d \
        --name "$name" \
        --label "ai-agent-vm=1" \
        --label "ai-agent-vm-path=$(pwd -P)" \
        -v "$(pwd -P):/workspace" \
        -v "$AUTH_VOLUME:/home/node/.claude" \
        -w /workspace \
        "$IMAGE_NAME" >/dev/null
      ;;
    *)
      die "container '$name' in unexpected state: $state"
      ;;
  esac
}

cmd_run() {
  need_docker
  ensure_image
  ensure_auth_volume
  local name
  name="$(project_container_name)"
  ensure_container "$name"
  # -it for interactive TTY; each invocation is a fresh agent process.
  # Forward any extra args to the agent binary (e.g. `ai-agent-vm --resume`).
  exec docker exec -it "$name" "$AGENT_BIN" "$@"
}

cmd_login() {
  need_docker
  ensure_image
  ensure_auth_volume
  echo "ai-agent-vm: starting one-time login. Browser will open; approve, then return here." >&2
  # Use a throwaway container with the OAuth port forwarded so the redirect reaches us.
  # Auth volume is mounted so the resulting token persists for all future project containers.
  docker run --rm -it \
    -p "127.0.0.1:${OAUTH_PORT}:${OAUTH_PORT}" \
    -v "$AUTH_VOLUME:/home/node/.claude" \
    "$IMAGE_NAME" "$AGENT_BIN" /login
  echo "ai-agent-vm: login complete. Credentials saved to volume '$AUTH_VOLUME'." >&2
}

cmd_shell() {
  need_docker
  ensure_image
  ensure_auth_volume
  local name
  name="$(project_container_name)"
  ensure_container "$name"
  exec docker exec -it "$name" bash
}

cmd_stop() {
  need_docker
  local name
  name="$(project_container_name)"
  [[ -n "$(container_state "$name")" ]] || die "no container for this directory"
  docker stop "$name" >/dev/null
  echo "stopped $name"
}

cmd_rm() {
  need_docker
  local name
  name="$(project_container_name)"
  [[ -n "$(container_state "$name")" ]] || die "no container for this directory"
  docker rm -f "$name" >/dev/null
  echo "removed $name"
}

cmd_ps() {
  need_docker
  docker ps -a --filter "label=ai-agent-vm=1" \
    --format 'table {{.Names}}\t{{.Status}}\t{{.Label "ai-agent-vm-path"}}'
}

cmd_rebuild() {
  need_docker
  docker build --no-cache -t "$IMAGE_NAME" "$SCRIPT_DIR"
}

cmd_upgrade() {
  need_docker
  ensure_image
  ensure_auth_volume
  local name version
  name="$(project_container_name)"
  # Optional version arg (default: latest). Lets you pin, e.g. `upgrade 2.1.230`.
  version="${1:-latest}"
  ensure_container "$name"

  # The CLI is installed globally as root in the image, so its own auto-updater
  # (which runs as the `node` user) can't write to /usr/local/lib/node_modules
  # and silently no-ops — that's why the version drifts. We reinstall as root.
  echo "ai-agent-vm: current version in $name:" >&2
  docker exec -u root "$name" "$AGENT_BIN" --version >&2 || true

  echo "ai-agent-vm: installing ${AGENT_PKG}@${version} inside $name ..." >&2
  docker exec -u root "$name" npm install -g "${AGENT_PKG}@${version}"

  echo "ai-agent-vm: new version in $name:" >&2
  docker exec -u root "$name" "$AGENT_BIN" --version >&2

  cat >&2 <<EOF

ai-agent-vm: NOTE — this upgraded ONLY this project's container ($name).
  * It survives 'stop'/'start' but is lost on 'ai-agent-vm rm' and is NOT
    present in any freshly created container.
  * Other project containers still run the image's baked-in version.
  To make a new version the default everywhere, snapshot it with
  'ai-agent-vm commit', or (durably) bump the image via 'ai-agent-vm rebuild'.
EOF
}

cmd_commit() {
  need_docker
  local name
  name="$(project_container_name)"
  [[ -n "$(container_state "$name")" ]] || die "no container for this directory"
  echo "ai-agent-vm: committing $name -> image '$IMAGE_NAME' ..." >&2
  # docker commit excludes the bind-mounted /workspace and the named volumes,
  # so it captures packages you apt/npm-installed in the container layer — the
  # answer to "update the image without a from-scratch rebuild".
  docker commit "$name" "$IMAGE_NAME" >/dev/null
  cat >&2 <<EOF
ai-agent-vm: image '$IMAGE_NAME' now reflects the current state of $name.
  Future containers will include deps you installed inside it.
  CAVEATS:
  * The image now DIVERGES from the Dockerfile — a later 'ai-agent-vm rebuild'
    rebuilds from source and drops these deps again. The durable fix is to add
    them to the Dockerfile so they survive rebuilds.
  * The commit also bakes in this container's local session state
    (~/.ai-agent-local: history, sessions, todos), so new containers inherit it.
EOF
}

cmd_help() {
  cat <<EOF
ai-agent-vm — AI Agent CLI in a per-project Docker container

Usage:
  ai-agent-vm [agent-args...]    Start/reuse this dir's container, run AI Agent CLI
  ai-agent-vm login              One-time OAuth login (port-forwards callback)
  ai-agent-vm shell              Bash shell inside this dir's container
  ai-agent-vm stop               Stop this dir's container
  ai-agent-vm rm                 Remove this dir's container
  ai-agent-vm ps                 List all ai-agent-vm containers
  ai-agent-vm upgrade [ver]      Update the CLI inside this dir's container
                                 (alias: update; default: latest, e.g.
                                 'upgrade 2.1.230'). Runs as root so it beats
                                 the root-owned-folder wall the CLI's own
                                 updater hits. In-place, keeps deps; lost on 'rm'.
  ai-agent-vm commit             Snapshot this dir's container into the image
                                 (preserves manually-installed deps; no rebuild)
  ai-agent-vm rebuild            Rebuild the Docker image from the Dockerfile
                                 (no cache; drops container-only deps)
  ai-agent-vm help               Show this help

Env:
  AI_AGENT_VM_IMAGE         (default: ai-agent-vm:latest)
  AI_AGENT_VM_PKG           (default: @anthropic-ai/claude-code)
  AI_AGENT_VM_AUTH_VOLUME   (default: ai-agent-vm-auth)
  AI_AGENT_VM_OAUTH_PORT    (default: 54545)
EOF
}

main() {
  local sub="${1:-run}"
  case "$sub" in
    login|shell|stop|rm|ps|rebuild|commit|help)
      shift
      "cmd_$sub" "$@"
      ;;
    upgrade|update)
      # 'update' is an alias — without it, the bare word falls through to the
      # agent binary and runs the CLI's own `claude update`, which can't write
      # the root-owned global install and fails. Route both to our root-based path.
      shift
      cmd_upgrade "$@"
      ;;
    -h|--help)
      cmd_help
      ;;
    *)
      # Treat everything else as args to the agent binary.
      cmd_run "$@"
      ;;
  esac
}

main "$@"
